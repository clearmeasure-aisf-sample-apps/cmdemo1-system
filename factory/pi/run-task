#!/usr/bin/env python3
"""Run ONE Pi task on one of the factory's GPUs and record its usage.

    run-task --run-dir DIR --cwd WORKTREE --task NAME --prompt-file FILE [--gpu pro5000|pro6000|obs|ts3|obs,ts3] [--timeout SEC] [--top-session ID]

- Runs `pi-gpu <gpu> -p <prompt>` (default GPU: $FACTORY_PI_GPU, else pro5000) in WORKTREE with stdin closed (Pi waits forever on an open stdin), no context files,
  skills or MCP, and its own session dir DIR/pi-sessions/NAME, so the session JSONL is kept.
- At most 2 Pi tasks run at once on pro5000, 1 on pro6000, 1 on obs and 1 on ts3 (hard caps): it waits for a slot from gpu_gate.py,
  the one gate every Pi launch goes through (#861), and hands the slot fd to pi-gpu / Pi, so the slot is held exactly as
  long as Pi or anything it started is alive (a killed run-task no longer frees the slot of a running orphan Pi).
- --gpu may list several GPUs (comma-separated, e.g. obs,ts3): Pi runs on the first with a free slot (reviews, #t83u);
  the record's "gpu" is the one that ran.
- Appends one record to DIR/tasks.jsonl: Pi session id, task, GPU, result, turns, input / cached / output tokens, wall
  time. The first call creates DIR/run.json with the top-level session id (--top-session or $FACTORY_TOP_SESSION)
  and the start time, which usage-report reads.
- Result is PASS / FAIL when the reply's last line says so (ask Pi to end with PASS or FAIL), timeout, or exit N.
  Exit code: 0 PASS, 125 no-start / stalled, 1 otherwise. Pi's reply tail is printed with secrets scrubbed.
- --timeout is hard: Pi runs in its own process group, so the timeout kills Pi AND every process Pi started (its tool
  subprocesses inherit the stdout pipe, so killing only Pi left communicate() blocked on them -- #817: --timeout 1800
  ran 4263 s with the GPU slot held). That group kill now lives in runner.run_cmd (#839), the one runner every
  factory command (the driver's sh included) goes through; run-task only maps the timeout to rc 124. The record says
  result "timeout", rc 124.
- --start-timeout SEC (drivers pass 900, t85u): a hand-off must really start. Once Pi holds its slot, no model output
  (an assistant record in a session file written by THIS launch; an older session file of a reused task name never
  counts) within SEC kills the whole Pi group: result "no-start". After the first model output the run is "stalled"
  only when neither a new session record nor CPU work in Pi's process group (a long build or test writes no record)
  shows for --stall-timeout SEC (default 2 x --start-timeout). The record says rc 125, run-task exits 125, and the
  driver relaunches it.
- --slot-wait SEC: give up waiting for a GPU slot after SEC (0 = wait as long as it takes). The slot wait is separate
  from, and never counted against, the --start-timeout clock. No slot: result "no-start", rc 125, exit 125.
- run-task atomically rewrites DIR/logs/NAME.progress.json (state waiting-for-slot, then running with gpu, pi pid,
  session lines and last activity every poll, then finished or no-slot): a visible heartbeat.
- Test overrides: FACTORY_PI_GPU_BIN (stand-in for ./pi-gpu) and FACTORY_PI_LOCK_DIR (stand-in for the real slot dir).
"""
import argparse, datetime as dt, fcntl, glob, json, os, re, signal, subprocess, sys, threading, time
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from scrub import scrub   # one scrub rule set (tokens, tunnel hosts, every LOCAL_LLM_*_URL / _TOKEN value)
from runner import run_cmd   # one runner with a deadline (#839, runner.py): it owns the process-group rules, shared with the driver's sh
import gpu as G
import gpu_gate

def now(): return dt.datetime.now(dt.timezone.utc)

def session_usage(path):
    tot = {"input": 0, "output": 0, "cacheRead": 0, "turns": 0}; sid = None
    for line in open(path):
        try: e = json.loads(line)
        except Exception: continue
        if e.get("type") == "session": sid = e.get("id")
        m = e.get("message")
        u = m.get("usage") if isinstance(m, dict) else None
        if u:
            tot["turns"] += 1
            for k in ("input", "output", "cacheRead"): tot[k] += int(u.get(k) or 0)
    return sid, tot

NO_START_RC = 125
PI_VERSION_TIMEOUT_S = 30   # `pi --version` prints at once; a hung probe must not hold the task (or the GPU slot) forever
TIMEOUT_RC = 124   # wall-clock timeout: Pi's group is killed, the record says result "timeout"

SLACK_S = 2.0      # mtime granularity: a session file Pi creates after launch is never older than launch - SLACK_S
CPU_ACTIVE_FRAC = 0.05   # Pi's group using >= 5% of a core between two polls is activity (a build or test running);
                         # an idle Pi waiting on a hung model call uses far less

def session_files(sdir, since=None):
    """Pi's session JSONL files under sdir, oldest first; with since, only those written at or after `since`. A reused
    task name keeps the session files of earlier runs: they are never this launch's activity (or its usage)."""
    out = []
    for f in glob.glob(os.path.join(sdir, "**", "*.jsonl"), recursive=True):
        try: m = os.path.getmtime(f)
        except OSError: continue
        if since is None or m >= since - SLACK_S: out.append((m, f))
    return [f for _, f in sorted(out)]

def is_model_record(line):
    """A model reply (an assistant message, or any message with token usage): not the header, not the user prompt."""
    try: e = json.loads(line)
    except Exception: return False
    m = e.get("message") if isinstance(e, dict) else None
    return isinstance(m, dict) and (m.get("role") == "assistant" or bool(m.get("usage")))

class SessionScan:
    """Incremental reader of the session files written since launch: poll() -> (records, any model output)."""
    def __init__(self, sdir, since): self.sdir, self.since, self.pos, self.lines, self.model = sdir, since, {}, 0, False
    def poll(self):
        for f in session_files(self.sdir, self.since):
            try:
                with open(f, "rb") as fh: fh.seek(self.pos.get(f, 0)); chunk = fh.read()
            except OSError: continue
            done = chunk[:chunk.rfind(b"\n") + 1]   # whole records only; a half-written one is read on the next poll
            self.pos[f] = self.pos.get(f, 0) + len(done)
            for l in done.decode(errors="replace").splitlines():
                if l.strip(): self.lines += 1; self.model = self.model or is_model_record(l)
        return self.lines, self.model

def group_cpu_s(pgid):
    """CPU seconds (user + system) used so far by the live processes of process group pgid (Linux /proc; 0 elsewhere)."""
    tot = 0
    for d in (os.listdir("/proc") if os.path.isdir("/proc") else ()):
        if not d.isdigit(): continue
        try: f = open(f"/proc/{d}/stat").read().rsplit(")", 1)[1].split()
        except (OSError, IndexError): continue
        if len(f) > 14 and f[2] == str(pgid): tot += sum(int(x) for x in f[11:15])   # utime stime + reaped children's
    return tot / os.sysconf("SC_CLK_TCK")

class WatchEvent(threading.Event):
    """A threading.Event with a declared `started` field: True once model output has arrived. The watch loop sets
    it; run_pi reads it to distinguish no-start (never) from stalled (yes). A real field, not a monkey-patched
    attribute on a plain Event (cmdemo1-system#946)."""
    def __init__(self):
        super().__init__()
        self.started = False

class ActivitySignal:
    """One source of activity in Pi's process group. The watch loop calls `tick(p, ev)` once per poll; a signal
    returns the new last-activity timestamp (or None if it saw nothing new). A third signal is added by appending
    to Watch.signals — the loop never changes (cmdemo1-system#946)."""
    def tick(self, p, ev):
        """Poll one activity source. Returns (new_lines, model_seen, last_activity) where new_lines is the
        cumulative session-line count (0 if this signal has no line count), model_seen is True if model output
        has ever been seen, and last_activity is a float timestamp or None if no activity was detected this tick."""
        raise NotImplementedError

class SessionActivity(ActivitySignal):
    """Activity from new session records: a new record or model output in a session file written since launch."""
    def __init__(self, scan):
        self.scan = scan
        self.seen = 0
    def tick(self, p, ev):
        n, model = self.scan.poll()
        if model:
            ev.started = True
        if n > self.seen:
            self.seen = n
            return (n, True, time.time())
        return (n, False, None)

class CpuActivity(ActivitySignal):
    """Activity from CPU work in Pi's process group: a long build or test writes no session record but burns CPU.
    Only active once model output has arrived (ev.started)."""
    def __init__(self, cpu=group_cpu_s, frac=CPU_ACTIVE_FRAC):
        self.cpu = cpu
        self.frac = frac
        self._prev = None   # (cpu_seconds, timestamp) baseline pair
    def tick(self, p, ev):
        if not ev.started:
            return (0, False, None)
        c, t = self.cpu(p.pid), time.time()
        if self._prev is not None and c - self._prev[0] >= self.frac * (t - self._prev[1]):
            self._prev = (c, t)
            return (0, False, t)
        self._prev = (c, t)
        return (0, False, None)

class Watch:
    """The hand-off watch configuration as one value object (cmdemo1-system#946): the session dir, the launch
    timestamp, the start / stall / poll clocks, the beat callback, and the list of ActivitySignals. The builder
    `Watch.for_run` computes poll_s = min(30.0, start_s / 4) and stall_s = stall_s or 2 * start_s, so every timing
    threshold lives in exactly one place."""
    def __init__(self, sdir, since, start_s, stall_s, poll_s, beat=None, signals=None):
        self.sdir = sdir
        self.since = since
        self.start_s = start_s
        self.stall_s = stall_s
        self.poll_s = poll_s
        self.beat = beat
        self.signals = signals if signals is not None else []
    @classmethod
    def for_run(cls, sdir, since, start_s, beat=None, stall_s=None, poll_s=None, cpu=group_cpu_s):
        """Build a Watch for one run: stall_s defaults to 2 x start_s, poll_s defaults to min(30.0, start_s / 4),
        and the default signal list is [SessionActivity, CpuActivity]."""
        stall = stall_s if stall_s is not None else 2 * start_s
        poll = poll_s if poll_s is not None else min(30.0, start_s / 4)
        scan = SessionScan(sdir, since)
        signals = [SessionActivity(scan), CpuActivity(cpu)]
        return cls(sdir, since, start_s, stall, poll, beat, signals)

def watch_progress(p, kill, watch):
    """Kill Pi's group when it has no model output within watch.start_s or, once it has, no activity from any
    signal for watch.stall_s (t85u). Returns a WatchEvent: set = killed; .started tells whether model output ever
    arrived (no-start vs stalled). Only session files written since watch.since (launch) count."""
    ev = WatchEvent()
    def loop():
        last = time.time()
        total_lines = 0
        while p.poll() is None:
            try:
                for sig in watch.signals:
                    n, model, act = sig.tick(p, ev)
                    if n: total_lines = n
                    if act is not None: last = act
                if watch.beat:
                    try:
                        watch.beat({"state": "running", "pi_pid": p.pid, "session_lines": total_lines,
                                    "model_output": ev.started,
                                    "last_activity": dt.datetime.fromtimestamp(last, dt.timezone.utc).isoformat(timespec="seconds")})
                    except Exception: pass   # a failed heartbeat (disk full) never ends the watch
                if time.time() - last > (watch.stall_s if ev.started else watch.start_s) and p.poll() is None:
                    ev.set(); kill(signal.SIGTERM); time.sleep(5); kill(signal.SIGKILL); return
            except Exception: pass         # one bad poll never turns the watchdog off
            time.sleep(watch.poll_s)
    threading.Thread(target=loop, daemon=True).start()
    return ev

def killed_by_watch(ev, rc):
    """The watch killed Pi, not: Pi exited on its own at the moment of the kill. A signal death is rc < 0 (or 143 / 137
    through a shell); any other exit code is Pi's own and is reported as such."""
    return ev is not None and ev.is_set() and (rc is None or rc < 0 or rc in (128 + signal.SIGTERM, 128 + signal.SIGKILL))

class PiRun:
    """Immutable result of run_pi: rc (exit code or TIMEOUT_RC/NO_START_RC), text (scrubbed output),
    started (True once Pi's child process was spawned; model-output arrival is tracked separately by the
    watch and folded into rc via NO_START_RC vs TIMEOUT_RC), timed_out (True when the wall-clock deadline
    fired, False otherwise)."""
    __slots__ = ("rc", "text", "started", "timed_out")
    def __init__(self, rc, text, started, timed_out):
        self.rc = rc; self.text = text; self.started = started; self.timed_out = timed_out
    def __repr__(self):
        return f"PiRun(rc={self.rc!r}, started={self.started!r}, timed_out={self.timed_out!r})"

def run_pi(cmd, cwd, timeout, slot_fd=None, env=None, watch=None):
    """Run Pi through runner.run_cmd, the one runner with a deadline (#839): it puts Pi in its own process group
    and, on timeout, SIGTERMs then SIGKILLs that whole group (the #817 rule, now written once) and hands the output
    collected before the pipe had to be closed back on the exception. Returns a PiRun(rc, text, started, timed_out);
    a timeout reports rc=TIMEOUT_RC, timed_out=True with the pre-kill output. With a watch (a Watch value object),
    a Pi with no model output within watch.start_s, or no activity for watch.stall_s after it, is killed the same
    way: rc=NO_START_RC; rc=NO_START_RC with started=False means it never produced model output."""
    def s(v): return (v.decode(errors="replace") if isinstance(v, bytes) else v) or ""
    ev = None
    child_spawned = False
    def on_spawn(p):   # run_cmd calls this with the live child before any waiting: the watch gets the handle it needs
        nonlocal ev, child_spawned
        def kill(sig):
            try: os.killpg(p.pid, sig)
            except ProcessLookupError: pass
        if watch is not None:
            ev = watch_progress(p, kill, watch)
        child_spawned = True   # the child exists: "not started" from here on means only "no model output"
    try:
        r = run_cmd(cmd, cwd=cwd, timeout=timeout, env=env, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT, text=True,
                    pass_fds=gpu_gate.slot_fds(slot_fd) if slot_fd is not None else (), on_spawn=on_spawn)
    except subprocess.TimeoutExpired as e:   # run_cmd already killed and reaped the whole group (#839)
        return PiRun(TIMEOUT_RC, s(e.output), child_spawned, timed_out=True)
    if killed_by_watch(ev, r.returncode):
        return PiRun(NO_START_RC, s(r.stdout), bool(ev.started), timed_out=False)
    return PiRun(r.returncode, s(r.stdout), child_spawned, timed_out=False)

def pi_version(timeout=PI_VERSION_TIMEOUT_S):
    """`pi --version`'s stdout for run.json, run through run_cmd so a hung probe is killed with its whole group after
    `timeout`; "" then (the record just lacks a version). stderr is discarded, as it was not part of the value."""
    try: return (run_cmd(["pi", "--version"], timeout=timeout, stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL).stdout or "").strip()
    except subprocess.TimeoutExpired: return ""

def write_json_atomic(path, obj):
    tmp = f"{path}.{os.getpid()}.tmp"
    with open(tmp, "w") as f: json.dump(obj, f)
    os.replace(tmp, path)   # a reader never sees half-written JSON

def gpu_list(v):
    gs = [g.strip() for g in str(v).split(",") if g.strip()]
    if not gs or any(g not in G.GPUS for g in gs): raise argparse.ArgumentTypeError(f"--gpu: one or more of {list(G.GPUS)}")
    return gs

def result_of(rc, started, last_line):
    """The record's result: no-start / stalled (NO_START_RC), timeout (TIMEOUT_RC), or PASS / FAIL / exit N
    from the reply's last non-empty line."""
    if rc == NO_START_RC: return "no-start" if not started else "stalled"
    if rc == TIMEOUT_RC: return "timeout"
    return "PASS" if "PASS" in last_line else ("FAIL" if "FAIL" in last_line else f"exit {rc}")

def exit_code_of(result, rc):
    """run-task's exit code: 0 PASS, NO_START_RC no-start / stalled, 1 otherwise."""
    return 0 if result == "PASS" else NO_START_RC if rc == NO_START_RC else 1

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--run-dir", required=True); p.add_argument("--cwd", required=True)
    p.add_argument("--task", required=True); p.add_argument("--prompt-file", required=True)
    p.add_argument("--timeout", type=int, default=G.PI_TASK_TIMEOUT_S); p.add_argument("--top-session")
    p.add_argument("--gpu", type=gpu_list, default=os.environ.get("FACTORY_PI_GPU") or G.LARGE_GPU)
    p.add_argument("--start-timeout", type=int, default=0); p.add_argument("--stall-timeout", type=int, default=0)
    p.add_argument("--slot-wait", type=int, default=0)
    a = p.parse_args()
    run = os.path.abspath(a.run_dir); os.makedirs(os.path.join(run, "logs"), exist_ok=True)
    meta = os.path.join(run, "run.json")
    if not os.path.exists(meta):
        json.dump({"top_session": a.top_session or os.environ.get("FACTORY_TOP_SESSION") or "unnamed",
                   "start": now().isoformat(timespec="seconds"),
                   "pi_version": pi_version()},
                  open(meta, "w"), indent=1)
    task = re.sub(r"[^A-Za-z0-9._-]", "-", a.task)
    sdir = os.path.join(run, "pi-sessions", task); os.makedirs(sdir, exist_ok=True)
    prompt = open(a.prompt_file).read()
    open(os.path.join(run, "logs", f"{task}.prompt.md"), "w").write(prompt)
    gs, t0 = a.gpu, now(); prog = os.path.join(run, "logs", f"{task}.progress.json"); gpu_now = ",".join(gs)
    def progress(**d):   # best effort: the heartbeat never fails the task
        try: write_json_atomic(prog, {"task": task, "gpu": gpu_now, "start": t0.isoformat(timespec="seconds"),
                                      "at": now().isoformat(timespec="seconds"), **d})
        except Exception: pass
    progress(state="waiting-for-slot")
    a.gpu, slot = gpu_gate.acquire_any(gs, max_wait=a.slot_wait or None)
    if slot is None:   # no slot within --slot-wait: never started, the driver relaunches on any free GPU
        rec = {"task": task, "gpu": gpu_now, "start": t0.isoformat(timespec="seconds"), "end": now().isoformat(timespec="seconds"),
               "rc": NO_START_RC, "result": "no-start", "why": f"no free slot on {gpu_now} within {a.slot_wait} s"}
        with open(os.path.join(run, "tasks.jsonl"), "a") as f: f.write(json.dumps(rec) + "\n")
        progress(state="no-slot", result="no-start", rc=NO_START_RC, end=rec["end"])
        print(json.dumps(rec)); sys.exit(NO_START_RC)
    t0, gpu_now = now(), a.gpu
    env = dict(os.environ, FACTORY_GPU_SLOT_FD=f"{a.gpu}:{slot}")
    pi_gpu = os.environ.get("FACTORY_PI_GPU_BIN") or os.path.join(HERE, "pi-gpu")
    launched = time.time()
    try:
        watch = Watch.for_run(sdir, launched, a.start_timeout, beat=lambda d: progress(**d),
                              stall_s=a.stall_timeout or None) if a.start_timeout else None
        pi_run = run_pi([pi_gpu, a.gpu, "--session-dir", sdir, "--no-context-files", "--no-skills", "--no-mcp",
                         "--approve", "-p", prompt], a.cwd, G.client_timeout(a.timeout), slot, env, watch=watch)
    finally:
        t1 = now(); gpu_gate.release(slot)
    rc, text = pi_run.rc, scrub(pi_run.text)
    open(os.path.join(run, "logs", f"{task}.out"), "w").write(text)
    files = session_files(sdir, launched)   # this launch's session only, never an older run's under the same task name
    sid, u = session_usage(files[-1]) if files else (None, {"input": 0, "output": 0, "cacheRead": 0, "turns": 0})
    last = ([l for l in text.strip().splitlines() if l.strip()][-1:] or [""])[0]
    result = result_of(rc, pi_run.started, last)
    rec = {"task": task, "gpu": a.gpu, "session_id": sid, "session_file": files[-1] if files else None,
           "start": t0.isoformat(timespec="seconds"), "end": t1.isoformat(timespec="seconds"),
           "wall_s": round((t1 - t0).total_seconds(), 1), "rc": rc, "result": result, **u}
    with open(os.path.join(run, "tasks.jsonl"), "a") as f: f.write(json.dumps(rec) + "\n")
    progress(state="finished", result=result, rc=rc, end=rec["end"])
    print(json.dumps(rec)); print("--- pi tail ---"); print(text[-1500:])
    sys.exit(exit_code_of(result, rc))

if __name__ == "__main__": main()

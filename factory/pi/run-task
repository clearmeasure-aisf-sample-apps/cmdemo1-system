#!/usr/bin/env python3
"""Run ONE Pi task on one of the factory's GPUs and record its usage.

    run-task --run-dir DIR --cwd WORKTREE --task NAME --prompt-file FILE [--gpu pro5000|obs|ts3|obs,ts3] [--timeout SEC] [--top-session ID]

- Runs `pi-gpu <gpu> -p <prompt>` (default GPU: $FACTORY_PI_GPU, else pro5000) in WORKTREE with stdin closed (Pi waits forever on an open stdin), no context files,
  skills or MCP, and its own session dir DIR/pi-sessions/NAME, so the session JSONL is kept.
- At most 2 Pi tasks run at once on pro5000, 1 on obs and 1 on ts3 (hard caps): it waits for a slot from gpu_gate.py,
  the one gate every Pi launch goes through (#861), and hands the slot fd to pi-gpu / Pi, so the slot is held exactly as
  long as Pi or anything it started is alive (a killed run-task no longer frees the slot of a running orphan Pi).
- --gpu may list several GPUs (comma-separated, e.g. obs,ts3): Pi runs on the first with a free slot (reviews, #t83u);
  the record's "gpu" is the one that ran.
- Appends one record to DIR/tasks.jsonl: Pi session id, task, GPU, result, turns, input / cached / output tokens, wall
  time. The first call creates DIR/run.json with the top-level session id (--top-session or $FACTORY_TOP_SESSION)
  and the start time, which usage-report reads.
- Result is PASS / FAIL when the reply's last line says so (ask Pi to end with PASS or FAIL), timeout, or exit N.
  Exit code: 0 PASS, 1 otherwise. Pi's reply tail is printed with secrets scrubbed.
- --timeout is hard: Pi runs in its own process group, so the timeout kills Pi AND every process Pi started (its tool
  subprocesses inherit the stdout pipe, so killing only Pi left communicate() blocked on them -- #817: --timeout 1800
  ran 4263 s with the GPU slot held). The record says result "timeout", rc 124.
- --start-timeout SEC (drivers pass 900, t85u): a hand-off must really start. No slot within SEC, or no new Pi session
  record (a model reply, a tool result) for SEC, kills the whole Pi group; the record says result "no-start" (never
  started: no slot or no model output) or "stalled", rc 125, and the driver relaunches it. While Pi runs, run-task
  rewrites DIR/logs/NAME.progress.json every poll (gpu, pi pid, session lines, last activity): a visible heartbeat.
- Test overrides: FACTORY_PI_GPU_BIN (stand-in for ./pi-gpu) and FACTORY_PI_LOCK_DIR (stand-in for the real slot dir).
"""
import argparse, datetime as dt, fcntl, glob, json, os, re, signal, subprocess, sys, threading, time
HERE = os.path.dirname(os.path.realpath(__file__))
sys.path.insert(0, HERE)
from item_loop import scrub   # one scrub rule set (tokens, tunnel hosts, every LOCAL_LLM_*_URL / _TOKEN value)
import gpu as G
import gpu_gate

def now(): return dt.datetime.now(dt.timezone.utc)

def session_usage(path):
    tot = {"input": 0, "output": 0, "cacheRead": 0, "turns": 0}; sid = None
    for line in open(path):
        try: e = json.loads(line)
        except Exception: continue
        if e.get("type") == "session": sid = e.get("id")
        m = e.get("message")
        u = m.get("usage") if isinstance(m, dict) else None
        if u:
            tot["turns"] += 1
            for k in ("input", "output", "cacheRead"): tot[k] += int(u.get(k) or 0)
    return sid, tot

NO_START_RC = 125

def session_lines(sdir):
    """Lines in Pi's newest session JSONL (the header is line 1; every model reply or tool result adds one)."""
    files = sorted(glob.glob(os.path.join(sdir, "**", "*.jsonl"), recursive=True), key=os.path.getmtime)
    try: return sum(1 for _ in open(files[-1])) if files else 0
    except OSError: return 0

def watch_progress(p, kill, sdir, start_s, beat=None, poll_s=None):
    """Kill Pi's group when its session gains no record for start_s (t85u). Returns an Event: set = killed, and
    .started tells whether any model record ever arrived (no-start vs stalled)."""
    ev = threading.Event(); ev.started = False; poll_s = poll_s or min(30.0, start_s / 4)
    def loop():
        seen, last = session_lines(sdir), time.time()
        while p.poll() is None:
            n = session_lines(sdir)
            if n > max(seen, 1): ev.started = True
            if n > seen: seen, last = n, time.time()
            if beat: beat({"pi_pid": p.pid, "session_lines": n, "last_activity": dt.datetime.fromtimestamp(last, dt.timezone.utc).isoformat(timespec="seconds")})
            if time.time() - last > start_s:
                ev.set(); kill(signal.SIGTERM); time.sleep(5); kill(signal.SIGKILL); return
            time.sleep(poll_s)
    threading.Thread(target=loop, daemon=True).start()
    return ev

def run_pi(cmd, cwd, timeout, slot_fd=None, env=None, sdir=None, start_s=None, beat=None):
    """Run Pi in its own process group; return (rc, output). On timeout SIGTERM then SIGKILL the whole group (#817),
    reporting rc 124 with whatever output was collected before the pipe had to be closed. With sdir and start_s, a Pi
    whose session gains no record for start_s is killed the same way: rc 125 (NO_START_RC); rc 125 with
    run_pi.started False means it never produced model output."""
    p = subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                         text=True, start_new_session=True,
                         pass_fds=gpu_gate.slot_fds(slot_fd) if slot_fd is not None else (), env=env)
    def kill(sig):
        try: os.killpg(p.pid, sig)
        except ProcessLookupError: pass
    def s(v): return (v.decode(errors="replace") if isinstance(v, bytes) else v) or ""
    text = ""; ev = watch_progress(p, kill, sdir, start_s, beat) if sdir and start_s else None
    run_pi.started = True
    try:
        out, _ = p.communicate(timeout=timeout)
        if ev is not None and ev.is_set(): run_pi.started = ev.started; return NO_START_RC, s(out)
        return p.returncode, s(out)
    except subprocess.TimeoutExpired as e:
        text = s(e.stdout)
        for sig in (signal.SIGTERM, signal.SIGKILL):
            kill(sig)
            try:
                out, _ = p.communicate(timeout=5); return 124, s(out) or text
            except subprocess.TimeoutExpired as e2:
                text = s(e2.stdout) or text
        try: p.stdout.close()     # a process outside the group still holds the pipe: stop waiting for EOF
        except OSError: pass
        try: p.wait(timeout=5)    # always reap: the group is killed, so this returns at once
        except subprocess.TimeoutExpired: pass
        return 124, text

def gpu_list(v):
    gs = [g.strip() for g in str(v).split(",") if g.strip()]
    if not gs or any(g not in G.GPUS for g in gs): raise argparse.ArgumentTypeError(f"--gpu: one or more of {list(G.GPUS)}")
    return gs

def main():
    p = argparse.ArgumentParser()
    p.add_argument("--run-dir", required=True); p.add_argument("--cwd", required=True)
    p.add_argument("--task", required=True); p.add_argument("--prompt-file", required=True)
    p.add_argument("--timeout", type=int, default=1500); p.add_argument("--top-session")
    p.add_argument("--gpu", type=gpu_list, default=os.environ.get("FACTORY_PI_GPU") or G.LARGE_GPU)
    p.add_argument("--start-timeout", type=int, default=0)
    a = p.parse_args()
    run = os.path.abspath(a.run_dir); os.makedirs(os.path.join(run, "logs"), exist_ok=True)
    meta = os.path.join(run, "run.json")
    if not os.path.exists(meta):
        json.dump({"top_session": a.top_session or os.environ.get("FACTORY_TOP_SESSION") or "unnamed",
                   "start": now().isoformat(timespec="seconds"),
                   "pi_version": subprocess.run(["pi", "--version"], capture_output=True, text=True).stdout.strip()},
                  open(meta, "w"), indent=1)
    task = re.sub(r"[^A-Za-z0-9._-]", "-", a.task)
    sdir = os.path.join(run, "pi-sessions", task); os.makedirs(sdir, exist_ok=True)
    prompt = open(a.prompt_file).read()
    open(os.path.join(run, "logs", f"{task}.prompt.md"), "w").write(prompt)
    gs, t0 = a.gpu, now()
    a.gpu, slot = gpu_gate.acquire_any(gs, max_wait=a.start_timeout or None)
    if slot is None:   # no slot within --start-timeout: never started, the driver relaunches on any free GPU
        rec = {"task": task, "gpu": ",".join(gs), "start": t0.isoformat(timespec="seconds"), "end": now().isoformat(timespec="seconds"),
               "rc": NO_START_RC, "result": "no-start", "why": f"no free slot on {','.join(gs)} within {a.start_timeout} s"}
        with open(os.path.join(run, "tasks.jsonl"), "a") as f: f.write(json.dumps(rec) + "\n")
        print(json.dumps(rec)); sys.exit(1)
    t0 = now(); prog = os.path.join(run, "logs", f"{task}.progress.json")
    beat = lambda d: json.dump({"task": task, "gpu": a.gpu, "start": t0.isoformat(timespec="seconds"),
                                "at": now().isoformat(timespec="seconds"), **d}, open(prog, "w"))
    env = dict(os.environ, FACTORY_GPU_SLOT_FD=f"{a.gpu}:{slot}")
    pi_gpu = os.environ.get("FACTORY_PI_GPU_BIN") or os.path.join(HERE, "pi-gpu")
    try:
        rc, text = run_pi([pi_gpu, a.gpu, "--session-dir", sdir, "--no-context-files", "--no-skills", "--no-mcp",
                           "--approve", "-p", prompt], a.cwd, max(a.timeout, G.MIN_CLIENT_TIMEOUT_S), slot, env,
                          sdir=sdir, start_s=a.start_timeout or None, beat=beat)
    finally:
        t1 = now(); gpu_gate.release(slot)
    text = scrub(text)
    open(os.path.join(run, "logs", f"{task}.out"), "w").write(text)
    files = sorted(glob.glob(os.path.join(sdir, "**", "*.jsonl"), recursive=True), key=os.path.getmtime)
    sid, u = session_usage(files[-1]) if files else (None, {"input": 0, "output": 0, "cacheRead": 0, "turns": 0})
    last = ([l for l in text.strip().splitlines() if l.strip()][-1:] or [""])[0]
    result = ("no-start" if not run_pi.started else "stalled") if rc == NO_START_RC else "timeout" if rc == 124 else ("PASS" if "PASS" in last else ("FAIL" if "FAIL" in last else f"exit {rc}"))
    rec = {"task": task, "gpu": a.gpu, "session_id": sid, "session_file": files[-1] if files else None,
           "start": t0.isoformat(timespec="seconds"), "end": t1.isoformat(timespec="seconds"),
           "wall_s": round((t1 - t0).total_seconds(), 1), "rc": rc, "result": result, **u}
    with open(os.path.join(run, "tasks.jsonl"), "a") as f: f.write(json.dumps(rec) + "\n")
    print(json.dumps(rec)); print("--- pi tail ---"); print(text[-1500:])
    sys.exit(0 if result == "PASS" else 1)

if __name__ == "__main__": main()

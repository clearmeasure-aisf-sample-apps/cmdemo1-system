@startuml 01-octopus-foothold
!include _c4.iuml
title Clear Measure work orders demo 1 | Phase 1: Octopus foothold (2026-10-03)

Boundary(box, "Operator machine omarchy") {
  Container(aiops, "Linux user aiops", "Claude Code, gh, az, pwsh", "Ran new-octopus-foothold.ps1")
}

Boundary(octo, "Octopus https://clearmeasure.octopus.app") {
  Container(aiops_octo, "ai-ops", "AI service account", "Octopus Managers")
  Boundary(space, "Space cmdemo1 demo (Spaces-355, slug cmdemo1-demo)") {
    Container(sa, "cmdemo1-github", "service account Users-782, Space Manager", "No password, no API key: GitHub signs in with OIDC (ExternalId e1f3246a-16cc-4aa8-b7e9-2aeaf9eb46ca)", $tags="new")
    Container(oidc_sys, "OIDC identity", "issuer token.actions.githubusercontent.com", "repo:clearmeasure-aisf-sample-apps/cmdemo1-system:environment:octopus", $tags="new")
    Container(oidc_app, "OIDC identity", "issuer token.actions.githubusercontent.com", "repo:clearmeasure-aisf-sample-apps/cmdemo1-workorders:environment:release", $tags="new")
  }
}

Boundary(gh, "GitHub org clearmeasure-aisf-sample-apps") {
  Container(sysrepo, "cmdemo1-system", "environment octopus", "Jobs octopus-apply and system-release", $tags="planned")
  Container(apprepo, "cmdemo1-workorders", "environment release", "Workflow release.yml", $tags="planned")
}

Rel(aiops, aiops_octo, "REST", "API key")
Rel(aiops_octo, space, "created; Space Manager", $tags="new")
Rel(oidc_sys, sa, "signs in as", $tags="new")
Rel(oidc_app, sa, "signs in as", $tags="new")
Rel(sysrepo, oidc_sys, "OIDC token", $tags="planned")
Rel(apprepo, oidc_app, "OIDC token", $tags="planned")

SHOW_LEGEND()
@enduml

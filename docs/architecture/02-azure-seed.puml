@startuml 02-azure-seed
!include _c4.iuml
title Clear Measure work orders demo 1 | Phase 2: Azure seed (2026-10-03)

Boundary(box, "Operator machine omarchy") {
  Container(aiops, "Linux user aiops", "az as cm-ai-ops", "Ran new-demo-seed.ps1: seed.bicep at subscription scope")
}

Boundary(sub, "Subscription Jeffrey MVP Azure subscription 7-25--7-27 (southcentralus)") {
  Boundary(rgn, "rg-cmdemo1-nonprod") {
    ContainerDb(acr, "acrcmdemo1chu4gq", "Container Registry, Basic", "Images cmdemo1/ui:<version>", $tags="new")
    ContainerDb(tfstate, "stcmdemo1tfchu4gq", "Storage account", "Terraform state of octopus/ (container tfstate)", $tags="new")
    Container(id_plan, "id-cmdemo1-plan", "managed identity", "Reader on both groups: what-if previews and drift", $tags="new")
    Container(id_cfg, "id-cmdemo1-octopus-config", "managed identity", "Storage Blob Data Contributor on the state account", $tags="new")
    Container(id_push, "id-cmdemo1-acr-push", "managed identity", "AcrPush on the registry", $tags="new")
    Container(id_dn, "id-cmdemo1-deploy-nonprod", "managed identity", "Owner of rg-cmdemo1-nonprod: applies the stacks of tdd, uat", $tags="new")
    Container(id_apps_n, "Runtime identities", "managed identities", "id-cmdemo1-tdd-app, id-cmdemo1-uat-app: AcrPull", $tags="new")
  }
  Boundary(rgp, "rg-cmdemo1-prod") {
    Container(id_dp, "id-cmdemo1-deploy-prod", "managed identity", "Owner of rg-cmdemo1-prod: applies the stacks of prod", $tags="new")
    Container(id_apps_p, "Runtime identities", "managed identities", "id-cmdemo1-prod-app: AcrPull", $tags="new")
  }
}

Boundary(gh, "GitHub org clearmeasure-aisf-sample-apps") {
  Container(sysrepo, "cmdemo1-system", "environments azure-read, octopus", $tags="planned")
  Container(apprepo, "cmdemo1-workorders", "environment release", $tags="planned")
}

Boundary(octo, "Octopus space cmdemo1 demo") {
  Container(projects, "Projects cmdemo1-system, cmdemo1-ui", "deployments per environment", "OIDC subjects space:cmdemo1-demo:project:<project>:environment:<env>", $tags="planned")
}

Rel(aiops, sub, "deployment seed-cmdemo1", "Owner", $tags="new")
Rel(sysrepo, id_plan, "federated: environment azure-read", $tags="planned")
Rel(sysrepo, id_cfg, "federated: environment octopus", $tags="planned")
Rel(apprepo, id_push, "federated: environment release", $tags="planned")
Rel(projects, id_dn, "federated: nonprod environments", $tags="planned")
Rel(projects, id_dp, "federated: prod environments", $tags="planned")
Rel(id_cfg, tfstate, "state", $tags="new")
Rel(id_push, acr, "push", $tags="new")

SHOW_LEGEND()
@enduml
